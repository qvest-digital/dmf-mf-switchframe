# Switchframe with MXL input and output, as a CPU image and a CUDA image.
#
#   docker build -f Dockerfile.mxl --target cpu  -t switchframe:mxl .
#   docker build -f Dockerfile.mxl --target cuda -t switchframe:mxl-cuda .
#
# Both build on go-mxl-builder, which ships libmxl prebuilt under
# /opt/libmxl, and run on go-mxl-runtime, which carries the same libmxl.
# Every reader and writer of one MXL domain has to link the same libmxl, so
# GO_MXL_TAG is the libmxl the rest of the domain runs, not a free choice.
# renovate: datasource=docker depName=ghcr.io/qvest-digital/go-mxl-builder
ARG GO_MXL_TAG=1.1.0-rc.7

# CUDA from NVIDIA's Debian 13 repository, the release of the go-mxl images.
# 13.2 is the newest the 595 driver branch runs without the forward
# compatibility package.
ARG CUDA_VERSION=13.2
# Kernels are compiled to native code for Turing (T4), Ampere (A10G), Ada (L4)
# and Blackwell consumer cards, plus Turing PTX, which every later card the
# list leaves out JIT-compiles at first start.
ARG CUDA_GENCODE="-gencode arch=compute_75,code=sm_75 -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 -gencode arch=compute_120,code=sm_120 -gencode arch=compute_75,code=compute_75"

# The HTML5 graphics renderer: CEF's minimal Linux distribution, with the
# SHA-1 cef-builds publishes beside the archive.
ARG CEF_VERSION=138.0.60+gd8bc8bd+chromium-138.0.7204.307
ARG CEF_SHA1=e53fa12159d4aa55ce7053b0d9270f5be94746a9
# What libcef.so links against. Linking switchframe-cef needs them as much as
# running it does.
ARG CEF_LIBS="libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \
      libdrm2 libgbm1 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
      libxrandr2 libxext6 libx11-6 libxcb1 libasound2t64 libpango-1.0-0 \
      libcairo2 libdbus-1-3 libexpat1 libatspi2.0-0t64 libglib2.0-0t64"

# ---------- UI ----------
FROM node:22-bookworm-slim AS ui
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# ---------- HTML5 graphics sidecar ----------
FROM debian:trixie-slim AS cef
ARG CEF_VERSION
ARG CEF_SHA1
ARG CEF_LIBS
RUN apt-get update && apt-get install -y --no-install-recommends \
      bzip2 ca-certificates cmake curl g++ make ${CEF_LIBS} \
 && rm -rf /var/lib/apt/lists/*
# Pruned in the layer that downloads it, so neither the image nor the build
# cache carries the 1.4 GB unstripped libcef.so. Only en-US is kept: Chromium
# falls back to it for any locale without a pack. chrome-sandbox goes too:
# the sidecar runs with no_sandbox.
RUN curl -fsSLo /tmp/cef.tar.bz2 \
      "https://cef-builds.spotifycdn.com/cef_binary_${CEF_VERSION}_linux64_minimal.tar.bz2" \
 && echo "${CEF_SHA1}  /tmp/cef.tar.bz2" | sha1sum -c - \
 && mkdir /opt/cef && tar -xjf /tmp/cef.tar.bz2 -C /opt/cef --strip-components=1 \
 && rm /tmp/cef.tar.bz2 \
 && rm -f /opt/cef/Release/chrome-sandbox \
 && find /opt/cef/Resources/locales -type f ! -name en-US.pak -delete \
 && strip --strip-unneeded /opt/cef/Release/*.so*
# Only what CMakeLists.txt reads, so a template or test edit does not
# recompile the sidecar.
COPY cef-sidecar/CMakeLists.txt /src/cef-sidecar/
COPY cef-sidecar/src/ /src/cef-sidecar/src/
COPY cef-sidecar/resources/ /src/cef-sidecar/resources/
# The install rpath ($ORIGIN) instead of the build tree's, so the binary
# finds libcef.so beside it once copied out.
RUN cmake -S /src/cef-sidecar -B /build -DCEF_ROOT=/opt/cef \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
 && make -C /build -j"$(nproc)" switchframe-cef \
 && strip /build/switchframe-cef \
 && install -D /build/switchframe-cef /out/switchframe-cef \
 && rm -rf /build

# ---------- build environment ----------
# Toolchains come before the source, so a source change rebuilds neither.
FROM ghcr.io/qvest-digital/go-mxl-builder:${GO_MXL_TAG} AS toolchain
# fdk-aac is in non-free.
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
      libx264-dev libfdk-aac-dev libopus-dev libopusfile-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*
ENV CGO_ENABLED=1
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
# go.mod replaces a module with this directory, which go mod download reads.
COPY server/third_party/ ./third_party/
RUN go mod download

FROM toolchain AS toolchain-cuda
ARG CUDA_VERSION
RUN curl -fsSLo /tmp/keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb \
 && dpkg -i /tmp/keyring.deb && rm /tmp/keyring.deb \
 && v=$(echo "${CUDA_VERSION}" | tr . -) \
 && apt-get update && apt-get install -y --no-install-recommends \
      cuda-nvcc-$v cuda-cudart-dev-$v cuda-driver-dev-$v libnpp-dev-$v \
 && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/cuda/bin:${PATH}

# The source without the UI: what the tests run against.
FROM toolchain AS build-base
COPY server/ ./

FROM build-base AS build-cpu
COPY --from=ui /app/ui/build ./cmd/switchframe/ui
RUN go build -tags "embed_ui mxl" -o /out/switchframe ./cmd/switchframe

FROM toolchain-cuda AS build-cuda
ARG CUDA_GENCODE
COPY server/ ./
COPY --from=ui /app/ui/build ./cmd/switchframe/ui
RUN make -C gpu/cuda ARCH="${CUDA_GENCODE}" all
# The headers sit under targets/ only: the include symlink comes with the full
# toolkit metapackage, which this stage does not install. libcuda comes from
# the host driver at run time; the toolkit's stub stands in for it at link
# time only. The NPP libraries are named on the link line but no symbol of
# theirs is used, so the runtime stage does not carry them.
RUN CGO_CFLAGS="-I/usr/local/cuda/targets/x86_64-linux/include" \
    CGO_LDFLAGS="-L/usr/local/cuda/lib64/stubs" \
    go build -tags "embed_ui mxl cuda" -o /out/switchframe ./cmd/switchframe

# ---------- runtime ----------
FROM ghcr.io/qvest-digital/go-mxl-runtime:${GO_MXL_TAG} AS runtime-base
ARG CEF_LIBS
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update && apt-get install -y --no-install-recommends \
      libavcodec61 libavformat61 libavutil59 libswscale8 libswresample5 \
      libx264-164 libfdk-aac2 libopus0 libopusfile0 curl ca-certificates \
      ${CEF_LIBS} fonts-dejavu-core fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
COPY LICENSE /usr/share/doc/switchframe/LICENSE
# The engine looks for switchframe-cef beside its own binary; the sidecar
# finds libcef.so and its resources beside the link's target. The CEF
# distribution changes only with CEF_VERSION, so it sits below the CUDA
# layers; the sidecar binary and the templates go in the last stages.
COPY --from=cef /opt/cef/Release/ /opt/cef/Resources/ /opt/switchframe-cef/bin/
RUN ln -s /opt/switchframe-cef/bin/switchframe-cef /usr/local/bin/switchframe-cef
EXPOSE 8080/udp 8080/tcp 9090/tcp
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9090/health || exit 1
# Root, unlike the upstream images: an MXL reader takes a slot in the shared
# header of a flow another process created, and the flow files carry that
# writer's ownership.
ENTRYPOINT ["switchframe", "--admin-addr=0.0.0.0:9090"]

FROM runtime-base AS cpu
COPY --from=cef /out/switchframe-cef /opt/switchframe-cef/bin/
COPY cef-sidecar/demo-templates/ /opt/switchframe-cef/demo-templates/
COPY --from=build-cpu /out/switchframe /usr/local/bin/switchframe

FROM runtime-base AS cuda
ARG CUDA_VERSION
RUN curl -fsSLo /tmp/keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb \
 && dpkg -i /tmp/keyring.deb && rm /tmp/keyring.deb \
 && v=$(echo "${CUDA_VERSION}" | tr . -) \
 && apt-get update && apt-get install -y --no-install-recommends \
      cuda-cudart-$v \
 && rm -rf /var/lib/apt/lists/* \
 && echo /usr/local/cuda/lib64 > /etc/ld.so.conf.d/cuda.conf && ldconfig
# Read by the NVIDIA container runtime: NVENC and NVDEC need the video
# capability on top of compute.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
COPY --from=cef /out/switchframe-cef /opt/switchframe-cef/bin/
COPY cef-sidecar/demo-templates/ /opt/switchframe-cef/demo-templates/
COPY --from=build-cuda /out/switchframe /usr/local/bin/switchframe
