{
  "name": "chapter-title",
  "description": "Cinematic chapter/segment title card with oversized background number, bold display typography, and dramatic GSAP entrance animations",
  "version": "1.0.0",
  "steps": 1,
  "dataSchema": {
    "type": "object",
    "properties": {
      "number": {
        "type": "string",
        "title": "Chapter Number",
        "default": "01"
      },
      "title": {
        "type": "string",
        "title": "Chapter Title",
        "default": "The Beginning"
      },
      "subtitle": {
        "type": "string",
        "title": "Subtitle / Description",
        "default": "Setting the stage for what comes next"
      },
      "accentColor": {
        "type": "string",
        "title": "Accent Color",
        "default": "#e63946"
      },
      "numberColor": {
        "type": "string",
        "title": "Number Color",
        "default": "#ffffff"
      },
      "titleSize": {
        "type": "string",
        "title": "Title Size",
        "default": "large",
        "enum": ["medium", "large", "xlarge"]
      },
      "showSubtitle": {
        "type": "boolean",
        "title": "Show Subtitle",
        "default": true
      },
      "ruleWidth": {
        "type": "number",
        "title": "Rule Width (px)",
        "default": 120
      },
      "numberOpacity": {
        "type": "number",
        "title": "Background Number Opacity",
        "default": 0.08
      },
      "fontStyle": {
        "type": "string",
        "title": "Font Style",
        "default": "modern",
        "enum": ["modern", "serif", "condensed"]
      }
    },
    "required": ["number", "title"]
  },
  "renderRequirements": {
    "width": 1920,
    "height": 1080,
    "frameRate": 30
  }
}
